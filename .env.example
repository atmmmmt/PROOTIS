# ─── API Server ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173

# JWT secrets — change to long random strings in production
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret

# ─── Database (optional — server uses in-memory data without this) ────────────
# MONGO_URI=mongodb://localhost:27017/prootech_system
# REDIS_URL=redis://localhost:6379

# ─── AI Integration (set AI_PROVIDER=anthropic and supply key to enable) ──────
AI_PROVIDER=disabled
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# ─── Webhooks ─────────────────────────────────────────────────────────────────
WEBHOOK_PAYMENT_SECRET=replace-with-a-long-random-webhook-secret

# ─── Object Storage (optional) ────────────────────────────────────────────────
# OBJECT_STORAGE_BUCKET=prootech-internal
